+++ b/cmake/modules/SwiftSharedCMakeConfig.cmake
@@ -189,6 +189,11 @@ macro(swift_common_standalone_build_config_llvm product)
 endmacro()
 
 macro(swift_common_standalone_build_config_clang product)
+  # The Emscripten Clang interpreter exports references to LLD's Wasm driver.
+  # Import those targets before Clang checks its transitive dependencies.
+  if(EMSCRIPTEN AND LLD_DIR)
+    find_package(LLD CONFIG REQUIRED NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
+  endif()
   find_package(Clang CONFIG REQUIRED NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
 
   if (NOT CMAKE_CROSSCOMPILING AND NOT SWIFT_PREBUILT_CLANG)
