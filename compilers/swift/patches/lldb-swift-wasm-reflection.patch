@@ -965,6 +965,39 @@
                                                likely_module_names);
   }
 
+  // Wasm data segments have linear-memory addresses, but a file-backed module
+  // has no loadable image header. Register its reflection segments directly.
+  if (obj_file->GetArchitecture().GetTriple().isWasm()) {
+    auto format = GetSwiftObjectFileFormat(llvm::Triple::Wasm);
+    auto info_id = m_reflection_ctx->AddImage(
+        [&](swift::ReflectionSectionKind kind)
+            -> std::pair<swift::remote::RemoteRef<void>, uint64_t> {
+          auto section = obj_file->GetSectionList()->FindSectionByName(
+              ConstString(format->getSectionName(kind)));
+          if (!section || !section->GetByteSize())
+            return {};
+          auto address = section->GetLoadBaseAddress(&target);
+          auto size = section->GetByteSize();
+          if (address == LLDB_INVALID_ADDRESS)
+            return {};
+          auto *buffer = malloc(size);
+          if (!buffer)
+            return {};
+          Status error;
+          if (GetProcess().ReadMemory(address, buffer, size, error) != size) {
+            free(buffer);
+            return {};
+          }
+          return {swift::remote::RemoteRef<void>(
+                      swift::remote::RemoteAddress(
+                          address, swift::remote::RemoteAddress::DefaultAddressSpace),
+                      buffer),
+                  size};
+        },
+        GetLikelySwiftImageNamesForModule(module_sp));
+    return info_id.has_value();
+  }
+
