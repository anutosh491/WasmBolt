+
+#include "WasmExecutor.h"
+#include "swift/Runtime/Config.h"
+#include "lld/Common/Driver.h"
+#include "llvm/IR/LegacyPassManager.h"
+#include "llvm/IR/Module.h"
+#include "llvm/MC/TargetRegistry.h"
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/Path.h"
+#include "llvm/Target/TargetMachine.h"
+#include <dlfcn.h>
+LLD_HAS_DRIVER(wasm)
+using namespace swift;
+llvm::Expected<std::unique_ptr<SwiftWasmExecutor>> SwiftWasmExecutor::Create(llvm::StringRef runtimeResourcePath) {
+  auto executor = std::make_unique<SwiftWasmExecutor>();
+  if (auto error = llvm::sys::fs::createUniqueDirectory("swift-repl-", executor->TempDir))
+    return llvm::errorCodeToError(error);
+  executor->TLSObject = runtimeResourcePath;
+  llvm::sys::path::append(executor->TLSObject, "emscripten", "wasm32", "crtbegin-mt.o");
+  return std::move(executor);
+}
+llvm::Error SwiftWasmExecutor::executeModule(llvm::Module *module, llvm::StringRef entry) {
+  std::string error;
+  auto *target = llvm::TargetRegistry::lookupTarget(module->getTargetTriple(), error);
+  if (!target) return llvm::make_error<llvm::StringError>(error, llvm::inconvertibleErrorCode());
+  llvm::TargetOptions options;
+  std::unique_ptr<llvm::TargetMachine> machine(target->createTargetMachine(
+      module->getTargetTriple(), "generic", "+atomics,+bulk-memory,+exception-handling,+tail-call",
+      options, llvm::Reloc::Model::PIC_));
+  module->setDataLayout(machine->createDataLayout());
+  if (auto *libraries = module->getNamedMetadata("llvm.dependent-libraries"))
+    libraries->eraseFromParent();
+  llvm::SmallString<256> object(TempDir), binary(TempDir);
+  llvm::sys::path::append(object, llvm::Twine(ModuleIndex) + ".o");
+  llvm::sys::path::append(binary, llvm::Twine(ModuleIndex++) + ".wasm");
+  std::error_code ec;
+  llvm::raw_fd_ostream stream(object, ec);
+  if (ec) return llvm::errorCodeToError(ec);
+  llvm::legacy::PassManager passes;
+  if (machine->addPassesToEmitFile(passes, stream, nullptr, llvm::CodeGenFileType::ObjectFile))
+    return llvm::make_error<llvm::StringError>("Cannot emit a Wasm cell", llvm::inconvertibleErrorCode());
+  passes.run(*module);
+  stream.close();
+  const char *arguments[] = {"wasm-ld", "--threads=1", "-shared", "-Bsymbolic", "--experimental-pic", "--import-memory",
+      "--shared-memory", "--allow-undefined", "--export-dynamic",
+      "--export=__wasm_call_ctors", "--export=_emscripten_tls_init",
+      TLSObject.c_str(), object.c_str(), "-o", binary.c_str()};
+  auto result = lld::lldMain(arguments, llvm::outs(), llvm::errs(), {{lld::Wasm, &lld::wasm::link}});
+  if (result.retCode || !result.canRunAgain)
+    return llvm::make_error<llvm::StringError>("Could not link the Wasm cell", llvm::inconvertibleErrorCode());
+  auto *handle = dlopen(binary.c_str(), RTLD_NOW | RTLD_GLOBAL);
+  if (!handle) return llvm::make_error<llvm::StringError>(dlerror(), llvm::inconvertibleErrorCode());
+  auto *symbol = dlsym(handle, entry.str().c_str());
+  if (!symbol) return llvm::make_error<llvm::StringError>(dlerror(), llvm::inconvertibleErrorCode());
+  // Match Swift's calling convention, including its implicit context/error parameters.
+  using Entry = void SWIFT_CC(swift)();
+  reinterpret_cast<Entry *>(symbol)();
+  // Loaded cells retain metadata and globals referenced by subsequent cells.
+  return llvm::Error::success();
+}
