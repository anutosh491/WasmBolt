{
    "name": "wasmbolt",
    "version": "0.7.0",
    "workspaces": [
        "lite/brand"
    ],
    "description": "A browser-only compiler explorer for C, C++, LLVM IR, and MLIR.",
    "keywords": [
        "compiler-explorer",
        "clang",
        "llvm",
        "mlir",
        "webassembly",
        "jupyterlab",
        "jupyterlite",
        "lumino"
    ],
    "homepage": "https://anutosh491.github.io/WasmBolt/",
    "bugs": {
        "url": "https://github.com/anutosh491/WasmBolt/issues"
    },
    "license": "BSD-3-Clause",
    "author": {
        "name": "Anutosh Bhat",
        "email": "andersonbhat491@gmail.com"
    },
    "files": [
        "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
        "style/**/*.{css,js,eot,gif,html,jpg,json,png,svg,woff2,ttf}",
        "src/**/*.{ts,tsx}",
        "schema/*.json",
        "compiler/**",
        "scripts/*.mjs",
        "runtime/src/*",
        "runtime/licenses/*",
        "runtime/locks/*",
        "runtime/*.{json,yml,txt,md}",
        "webpack.config.cjs",
        "scripts/*.py"
    ],
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "style": "style/index.css",
    "repository": {
        "type": "git",
        "url": "https://github.com/anutosh491/WasmBolt.git"
    },
    "scripts": {
        "build": "jlpm build:lib && jlpm build:worker && jlpm check:compiler && jlpm build:labextension:dev",
        "build:prod": "jlpm build:lib && jlpm build:worker && jlpm check:compiler && jlpm build:labextension",
        "build:package": "jlpm build:prod && jlpm build:site",
        "build:labextension": "jupyter-builder build .",
        "build:labextension:dev": "jupyter-builder build --development True .",
        "build:lib": "jlpm build:guide && tsc -b tsconfig.json tsconfig.worker.json",
        "build:guide": "node scripts/guide.mjs",
        "build:lib:prod": "jlpm build:lib",
        "clean": "jlpm clean:lib",
        "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
        "clean:lintcache": "rimraf .eslintcache .stylelintcache",
        "clean:lab": "rimraf wasmbolt/labextension wasmbolt/_version.py",
        "clean:labextension": "jlpm clean:lab",
        "clean:all": "jlpm clean:lib && jlpm clean:lab && jlpm clean:lintcache",
        "eslint": "jlpm eslint:check --fix",
        "eslint:check": "eslint src --max-warnings 0",
        "install:extension": "jlpm build",
        "lint": "jlpm stylelint && jlpm prettier && jlpm eslint",
        "lint:check": "jlpm stylelint:check && jlpm prettier:check && jlpm eslint:check",
        "prettier": "jlpm prettier:base --write --list-different",
        "prettier:base": "prettier \"src/**/*.{ts,tsx}\" \"scripts/*.mjs\" \"ui-tests/tests/*.ts\" \"*.{json,mjs,cjs}\" \"style/*.{css,js}\" \"standalone/*.html\" \"lite/*.json\" lite/brand/package.json \"schema/*.json\" README.md CONTRIBUTING.md AGENTS.md RELEASE.md runtime/README.md ui-tests/README.md",
        "prettier:check": "jlpm prettier:base --check",
        "stylelint": "jlpm stylelint:check --fix",
        "stylelint:check": "stylelint --cache \"style/**/*.css\"",
        "test": "jlpm build:guide && jest --runInBand",
        "watch": "jlpm build:guide && run-p watch:guide watch:src watch:labextension",
        "watch:guide": "node scripts/guide.mjs --watch",
        "watch:src": "tsc -b tsconfig.json tsconfig.worker.json -w",
        "watch:labextension": "jupyter-builder watch .",
        "build:worker": "node scripts/workers.mjs",
        "build:compiler": "node scripts/compiler.mjs build",
        "check:compiler": "node scripts/compiler.mjs check",
        "build:standalone": "jlpm build:lib && jlpm build:worker && jlpm check:compiler && vite build",
        "build:lite": "jlpm build && node scripts/lite.mjs",
        "build:site": "jlpm build:standalone && node scripts/lite.mjs && node scripts/site.mjs",
        "serve": "python -m http.server 8080 --directory lite/_output",
        "serve:standalone": "vite preview --host 127.0.0.1",
        "serve:site": "python -m http.server 8080 --directory dist/site",
        "dev:standalone": "jlpm build:guide && vite --host 127.0.0.1",
        "typecheck": "jlpm build:lib && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
        "test:browser": "playwright test",
        "test:packages": "node scripts/packages.mjs"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.0",
        "@codemirror/commands": "^6.8.0",
        "@codemirror/lang-cpp": "^6.0.3",
        "@codemirror/language": "^6.11.0",
        "@codemirror/legacy-modes": "^6.5.2",
        "@codemirror/search": "^6.6.0",
        "@codemirror/state": "^6.5.0",
        "@codemirror/view": "^6.36.0",
        "@jupyterlab/application": "^4.6.0",
        "@jupyterlab/apputils": "^4.7.0",
        "@jupyterlab/coreutils": "^6.6.0",
        "@jupyterlab/launcher": "^4.6.0",
        "@jupyterlab/settingregistry": "^4.6.0",
        "@jupyterlab/statedb": "^4.6.0",
        "@lezer/highlight": "^1.2.3",
        "@lumino/commands": "^2.3.3",
        "@lumino/coreutils": "^2.2.2",
        "@lumino/disposable": "^2.1.5",
        "@lumino/messaging": "^2.0.3",
        "@lumino/widgets": "^2.7.3",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "wabt": "1.0.39"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@jupyter/builder": "^1.2.0",
        "@jupyter/eslint-plugin": "^1.1.0",
        "@jupyterlab/testutils": "^4.0.0",
        "@playwright/test": "^1.60.0",
        "@types/jest": "^29.2.0",
        "@types/json-schema": "^7.0.11",
        "@types/node": "^24.0.0",
        "@types/react": "^18.0.26",
        "@types/react-dom": "^18.2.0",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^15.0.0",
        "jest": "^29.2.0",
        "marked": "^17.0.6",
        "npm-run-all2": "^7.0.1",
        "prettier": "^3.0.0",
        "rimraf": "^5.0.1",
        "stylelint": "^15.10.1",
        "stylelint-config-recommended": "^13.0.0",
        "stylelint-config-standard": "^34.0.0",
        "stylelint-csstree-validator": "^3.0.0",
        "stylelint-prettier": "^4.0.0",
        "typescript": "~5.5.4",
        "typescript-eslint": "^8.0.0",
        "vite": "^7.0.0",
        "yjs": "^13.5.0"
    },
    "resolutions": {
        "lib0": "0.2.111",
        "webpack": "5.106.0"
    },
    "sideEffects": [
        "style/*.css",
        "style/index.js"
    ],
    "styleModule": "style/index.js",
    "publishConfig": {
        "access": "public"
    },
    "jupyterlab": {
        "extension": "lib/jupyter/plugin.js",
        "outputDir": "wasmbolt/labextension",
        "schemaDir": "schema",
        "webpackConfig": "webpack.config.cjs"
    },
    "prettier": {
        "singleQuote": true,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "endOfLine": "auto",
        "overrides": [
            {
                "files": "package.json",
                "options": {
                    "tabWidth": 4
                }
            }
        ],
        "printWidth": 80,
        "proseWrap": "always"
    },
    "stylelint": {
        "extends": [
            "stylelint-config-recommended",
            "stylelint-config-standard",
            "stylelint-prettier/recommended"
        ],
        "plugins": [
            "stylelint-csstree-validator"
        ],
        "rules": {
            "csstree/validator": true,
            "property-no-vendor-prefix": null,
            "selector-class-pattern": "^([a-z][A-z\\d]*)(-[A-z\\d]+)*$",
            "selector-no-vendor-prefix": null,
            "value-no-vendor-prefix": null
        }
    }
}
