 {
@@ -328,3 +354,25 @@ wasm_gdbserver_handle_packet(WASMGDBServer *server)
 
     return true;
 }
+
+bool
+wasm_gdbserver_feed(WASMGDBServer *server, const uint8 *data, uint32 size)
+{
+    uint32 i;
+
+    if (!server || !data)
+        return false;
+
+    for (i = 0; i < size; ++i) {
+        int ret = on_rsp_byte_arrive(data[i], server->receive_ctx);
+        if (ret == 1) {
+            if (!server->noack)
+                write_data_raw(server, (uint8 *)"+", 1);
+            process_packet(server);
+        }
+        else if (ret == 2) {
+            handle_interrupt(server);
+        }
+    }
+    return true;
+}
