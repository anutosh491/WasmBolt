+bool
+wasm_debug_instance_wait_for_stop(WASMDebugInstance *instance, uint32 *status)
+{
+    WASMExecEnv *stopped_thread;
+
+    if (!instance)
+        return false;
+
+    os_mutex_lock(&instance->wait_lock);
+    while (!instance->stopped_thread)
+        os_cond_wait(&instance->wait_cond, &instance->wait_lock);
+
+    stopped_thread = instance->stopped_thread;
+    wasm_debug_instance_set_cur_thread(instance, stopped_thread->handle);
+    if (status)
+        *status = (uint32)stopped_thread->current_status->signal_flag;
+    instance->current_state = APP_STOPPED;
+    instance->stopped_thread = NULL;
+    os_mutex_unlock(&instance->wait_lock);
+    return true;
+}
