+#ifdef __EMSCRIPTEN__
+#include "support/Shutdown.h"
+#include <emscripten.h>
+#include <type_traits>
+#include <utility>
+
+// Browser workers receive LSP messages asynchronously. Yield the Wasm stack
+// until JavaScript has queued bytes for Emscripten's stdin callback.
+EM_ASYNC_JS(void, waitForClangdStdin, (), { await Module.stdinReady(); })
+
+template <typename Fun, typename Ret = decltype(std::declval<Fun>()())>
+Ret readAfterBrowserStdin(const std::enable_if_t<true, Ret> &Fail,
+                          const Fun &Read) {
+  waitForClangdStdin();
+  return clang::clangd::retryAfterSignalUnlessShutdown(Fail, Read);
+}
+
+// Keep native clangd's transport unchanged. Only Emscripten replaces the two
+// blocking stdio reads below with an Asyncify-backed browser wait.
+#define retryAfterSignalUnlessShutdown readAfterBrowserStdin
+#endif
+
